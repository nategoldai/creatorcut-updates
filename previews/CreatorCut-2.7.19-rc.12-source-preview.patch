+    if not report.get('listened_audio'):
+        audio=util.read_json(p/'render/audio-check.json',default={})
+        if report.get('audio_method')!='signal_analysis' or not candidate or audio.get('candidate_sha256')!=candidate.get('sha256'):errors.append('Listen to audio or bind signal_analysis to this candidate.')
+    if (not report.get('watched_video') or not report.get('listened_audio')) and not report.get('limitations'):errors.append('Disclose frame/signal inspection limitations.')
+    checks=report.get('checks') if isinstance(report.get('checks'),dict) else {}
+    for key in CHECKS:
+        row=checks.get(key)
+        if not isinstance(row,dict) or row.get('pass') is not True or len(str(row.get('observations','')).strip())<12:errors.append('Review '+key+' with specific observations.')
+    reviewed=report.get('scenes') if isinstance(report.get('scenes'),dict) else {}
+    for row in scene.get('scenes',[]) if isinstance(scene,dict) else []:
+        if not isinstance(row,dict):continue
+        result=reviewed.get(row.get('id'),{})
+        if not isinstance(result,dict) or result.get('pass') is not True or len(str(result.get('observations','')).strip())<12:errors.append('Inspect entry, motion, hold and exit for scene '+str(row.get('id'))+'.')
+    if report.get('issues'):errors.append('Resolve the reported review issues before publication.')
+    evidence=util.read_json(p/'render/evidence.json',default={})
