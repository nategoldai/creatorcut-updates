+"""Delivery transactions and policy; real media encoding is checked separately."""
+import json,sys,tempfile,unittest
+from pathlib import Path
+from unittest.mock import patch
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from editkit import delivery,util
+
+class DeliveryTests(unittest.TestCase):
+    def setUp(self):
+        t=tempfile.TemporaryDirectory();self.addCleanup(t.cleanup);self.p=Path(t.name);self.src=self.p/'source.mp4';self.src.write_bytes(b'original')
+        self.input={'duration':2,'fps':24,'width':1080,'height':1920,'hdr':False,'has_audio':True}
+        self.commands=[]
+        def encode(cmd,*a,**kw):self.commands.append(cmd);Path(cmd[-1]).write_bytes(b'encoded')
+        def probe(path):return dict(self.input,fps=24 if Path(path)==self.src else 30)
+        for obj,key,value in [(util,'probe',probe),(util,'ffmpeg_bin',lambda:'ffmpeg'),(util,'run_progress',encode),(util,'run',lambda *a,**kw:None)]:
+            m=patch.object(obj,key,value);m.start();self.addCleanup(m.stop)
+    def test_profile_and_timing_are_explicit(self):
+        out=delivery.prepare(self.p,self.src);cmd=self.commands[0]
+        self.assertEqual(cmd[cmd.index('-vf')+1],'fps=30,setsar=1')
+        for key,value in [('-g','30'),('-b:v','12M'),('-ar','44100'),('-b:a','160k'),('-bf','1'),('-pix_fmt','yuv420p')]:self.assertEqual(cmd[cmd.index(key)+1],value)
+        self.assertNotIn('-t',cmd);self.assertNotIn('-shortest',cmd)
+        self.assertTrue(out.exists());self.assertEqual(self.src.read_bytes(),b'original')
+    def test_same_source_and_archived_delivery_are_not_reencoded(self):
+        out=delivery.prepare(self.p,self.src)
+        self.assertEqual(delivery.prepare(self.p,self.src),out)
+        self.assertEqual(delivery.prepare(self.p,out),out)
+        self.assertEqual(len(self.commands),1)
+    def test_failed_encode_preserves_prior_good_file(self):
+        good=delivery.prepare(self.p,self.src);self.src.write_bytes(b'changed original')
+        with patch.object(util,'run_progress',side_effect=util.Fail('encoder failed')):
+            with self.assertRaises(util.Fail):delivery.prepare(self.p,self.src)
+        self.assertEqual(good.read_bytes(),b'encoded');self.assertFalse(list((self.p/'render').glob('*.partial.mp4')))
+    def test_tampered_cache_is_not_reused(self):
+        out=delivery.prepare(self.p,self.src);out.write_bytes(b'corrupt')
+        delivery.prepare(self.p,self.src);self.assertEqual(len(self.commands),2)
+    def test_landscape_4k_is_not_cropped_and_uses_appropriate_level(self):
+        self.input.update(width=3840,height=2160)
+        delivery.prepare(self.p,self.src);cmd=self.commands[0]
+        self.assertEqual(cmd[cmd.index('-level:v')+1],'5.1')
+        self.assertNotIn('crop',cmd[cmd.index('-vf')+1]);self.assertNotIn('scale',cmd[cmd.index('-vf')+1])
+    def test_duration_mismatch_does_not_publish(self):
+        with patch.object(util,'probe',side_effect=lambda path:dict(self.input,fps=24 if Path(path)==self.src else 30,duration=2 if Path(path)==self.src else 3)):
+            with self.assertRaises(util.Fail):delivery.prepare(self.p,self.src)
+        self.assertFalse((self.p/'render'/'delivery-profile.json').exists())
+
+if __name__=='__main__':unittest.main()
