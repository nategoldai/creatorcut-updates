+"""Real inherited pipes must not trap the scheduler during connection cleanup."""
+import os,signal,subprocess,sys,tempfile,threading,time,unittest
+from pathlib import Path
+from unittest.mock import patch
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from editkit import util
+from editkit.editor_rpc import RPC
+
+class RPCShutdown(unittest.TestCase):
+ def wait_file(self,path,process):
+  until=time.monotonic()+10
+  while not path.exists() and process.poll() is None and time.monotonic()<until:time.sleep(.01)
+  self.assertTrue(path.exists())
+ @unittest.skipIf(os.name=='nt','POSIX inherited-pipe fixture')
+ def test_detached_child_holding_output_cannot_block_close(self):
+  with tempfile.TemporaryDirectory() as td:
+   path=Path(td)/'child.pid'
+   code="import subprocess,sys,time;from pathlib import Path;p=subprocess.Popen([sys.executable,'-c','import time;time.sleep(30)'],start_new_session=True);target=Path(sys.argv[1]);tmp=target.with_suffix('.tmp');tmp.write_text(str(p.pid));tmp.replace(target);time.sleep(30)"
+   rpc=RPC([sys.executable,'-c',code,str(path)],td);ended=threading.Event();errors=[]
+   def close():
+    try:rpc.close()
+    except Exception as e:errors.append(e)
+    finally:ended.set()
+   try:
+    self.wait_file(path,rpc.process);thread=threading.Thread(target=close,daemon=True);thread.start()
+    self.assertTrue(ended.wait(2),'Inherited output pipe trapped RPC.close')
+    self.assertFalse(errors);self.assertIsNotNone(rpc.process.poll())
+    # A detached helper is outside our owned group: no unrelated PID signal.
+    os.kill(int(path.read_text()),0)
+   finally:
+    if path.exists():
+     try:os.kill(int(path.read_text()),signal.SIGTERM)
+     except ProcessLookupError:pass
+    rpc.process.terminate() if rpc.process.poll() is None else None
+    ended.wait(2)
+ @unittest.skipIf(os.name=='nt','POSIX owned process-group fixture')
+ def test_connection_owns_group_and_stops_its_inherited_helper(self):
+  with tempfile.TemporaryDirectory() as td:
+   path=Path(td)/'child.pid'
+   code="import subprocess,sys,time;from pathlib import Path;p=subprocess.Popen([sys.executable,'-c','import time;time.sleep(30)']);target=Path(sys.argv[1]);tmp=target.with_suffix('.tmp');tmp.write_text(str(p.pid));tmp.replace(target);time.sleep(30)"
+   rpc=RPC([sys.executable,'-c',code,str(path)],td)
+   try:
+    self.wait_file(path,rpc.process)
+    self.assertEqual(os.getpgid(rpc.process.pid),rpc.process.pid)
+    helper=int(path.read_text());self.assertEqual(os.getpgid(helper),rpc.process.pid)
+    rpc.close();self.assertIsNotNone(rpc.process.poll())
+    self.assertTrue(rpc.closed.is_set());begun=time.monotonic();rpc.close();self.assertLess(time.monotonic()-begun,.5)
+   finally:
+    if path.exists():
+     try:os.kill(int(path.read_text()),signal.SIGTERM)
+     except ProcessLookupError:pass
+    rpc.close()
