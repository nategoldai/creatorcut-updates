+            with patch.object(util,'PROJECTS',Path(tmp)),patch.object(util,'ffprobe_bin',side_effect=util.Fail('ffprobe is missing')):
+                with self.assertRaisesRegex(util.Fail,'ffprobe is missing'):videos.add_media('demo',clip,'raw','upload.mp4')
+            self.assertEqual(clip.read_bytes(),b'fixture')
+
