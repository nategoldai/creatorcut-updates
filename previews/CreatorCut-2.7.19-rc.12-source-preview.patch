+import unittest,tempfile,subprocess,sys,time,os,json
+from pathlib import Path
+class WorkerShutdown(unittest.TestCase):
+ def test_shutdown_reaps_its_idle_provider_process(self):
+  kit=Path(__file__).resolve().parents[1]
+  with tempfile.TemporaryDirectory() as td:
+   root=Path(td)
+   code='''import sys,subprocess,threading
+from pathlib import Path
+sys.path.insert(0,sys.argv[1])
+from editkit import editor,util
+root=Path(sys.argv[2]);util.ROOT=root;util.STUDIO_OUT=root/'out';util.PROJECTS=root/'projects';util.PROJECTS.mkdir()
+Pool=editor.ProviderPool
+class RPC:
+ def __init__(self):
+  self.process=subprocess.Popen([sys.executable,'-c','import time;time.sleep(8)']);self.closed=threading.Event();(root/'child.pid').write_text(str(self.process.pid))
+ def close(self):
+  self.closed.set();self.process.terminate();self.process.wait(timeout=3)
+def pool(*args,**kwargs):
+ p=Pool();r,_=p.acquire('idle',RPC);p.release('idle',r,True);return p
+editor.ProviderPool=pool
+editor.worker()
+'''
+   proc=subprocess.Popen([sys.executable,'-c',code,str(kit),str(root)],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
+   try:
+    deadline=time.monotonic()+5
+    while not (root/'.creatorcut-editor-control/worker.json').exists() and time.monotonic()<deadline:
+     if proc.poll() is not None:self.fail(proc.communicate()[1])
+     time.sleep(.02)
+    self.assertTrue((root/'.creatorcut-editor-control/worker.json').exists())
+    child=int((root/'child.pid').read_text());proc.terminate();out,err=proc.communicate(timeout=5);self.assertEqual(proc.returncode,0,err)
+    with self.assertRaises(ProcessLookupError):os.kill(child,0)
+   finally:
+    if proc.poll() is None:proc.kill();proc.communicate(timeout=3)
