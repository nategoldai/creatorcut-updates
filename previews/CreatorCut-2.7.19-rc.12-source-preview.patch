+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from editkit import util, activity_store, resources, state, motion
+KIT = Path(__file__).resolve().parents[1]
+BOOT = "import sys;from pathlib import Path;sys.path.insert(0,sys.argv[1]);from editkit import util,activity_store,resources;util.STUDIO_OUT=Path(sys.argv[2]);"
+
+class ConcurrentWorkersTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup);self.root=Path(self.tmp.name)
+        patcher=patch.object(util,'STUDIO_OUT',self.root);patcher.start();self.addCleanup(patcher.stop)
+        token=activity_store._current.set(None);self.addCleanup(activity_store._current.reset,token)
+    def child(self, code, *args):
+        p=subprocess.Popen([sys.executable,'-c',BOOT+code,str(KIT),str(self.root),*map(str,args)],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
+        self.addCleanup(lambda: util.stop_process(p) if p.poll() is None else None)
+        return p
+    def wait_file(self, path):
+        deadline=time.monotonic()+8
+        while not path.exists():
+            if time.monotonic()>deadline:self.fail('Worker did not create '+str(path))
+            time.sleep(.02)
+    def finish(self,p):
+        out,err=p.communicate(timeout=10);self.assertEqual(p.returncode,0,out+err)
