+def _runtime_keys(changed):
+    result=[]
+    if any(x in changed for x in ('kit/requirements.txt','kit/requirements-vision.txt','kit/requirements-engine.lock')):result.append('python')
+    if any(x in changed for x in ('kit/requirements-claude.txt','kit/requirements-claude.lock')):
+        from . import editor
+        if editor.provider_name()=='claude':result.append('claude')
+    if any(x in changed for x in ('kit/render/package.json','kit/render/package-lock.json')):result.append('node')
+    return result
+
+def _backup_runtime_dependencies(changed,transaction):
+    keys=_runtime_keys(changed)
+    if not keys:return
+    rows={key:{'path':RUNTIME_PATHS[key],'existed':(util.ROOT/RUNTIME_PATHS[key]).exists()} for key in keys}
+    # A complete old runtime is retained before any package manager can modify it.
+    estimate=0
+    for row in rows.values():
+        path=util.ROOT/row['path']
+        if path.is_symlink():raise util.Fail('The editing tools must be private local folders before updating. Your current tools were kept.')
+        if path.is_dir():estimate+=sum(f.stat().st_size for f in path.rglob('*') if f.is_file() and not f.is_symlink())
+    if shutil.disk_usage(util.ROOT).free<estimate+2_500_000_000:raise util.Fail('This update needs more free space to keep a working rollback copy. Your current version was kept.')
+    transaction['runtimes']=rows;util.write_durable_json(BACKUP/'backup.json',transaction)
+    for key,row in rows.items():
+        old=util.ROOT/row['path'];saved=BACKUP/'runtimes'/key
+        if row['existed']:
+            saved.parent.mkdir(parents=True,exist_ok=True);os.replace(old,saved)
+            shutil.copytree(saved,old,symlinks=True)
+
+def _restore_runtime_dependencies(info):
+    rows=info.get('runtimes',{})
+    if not isinstance(rows,dict):raise util.Fail('The runtime recovery record is not valid.')
+    for key,row in rows.items():
+        if key not in RUNTIME_PATHS or not isinstance(row,dict) or row.get('path')!=RUNTIME_PATHS[key]:raise util.Fail('The runtime recovery path is not valid.')
+    for key,row in rows.items():
+        live=util.ROOT/row['path'];saved=BACKUP/'runtimes'/key
+        if saved.is_dir():
+            if live.is_symlink():live.unlink()
+            elif live.exists():shutil.rmtree(live)
+            live.parent.mkdir(parents=True,exist_ok=True);os.replace(saved,live)
+        elif not row.get('existed'):
+            if live.is_symlink():live.unlink()
+            elif live.exists():shutil.rmtree(live)
+
