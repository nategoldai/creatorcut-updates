+        code="activity_store.begin(sys.argv[3],label=sys.argv[3]);util.activity(sys.argv[3],float(sys.argv[4]));(util.STUDIO_OUT/(sys.argv[3]+'-ready')).touch();import time\nwhile not (util.STUDIO_OUT/(sys.argv[3]+'-release')).exists(): time.sleep(.02)\nactivity_store.update(running=False)"
+        a=self.child(code,'radical',71);b=self.child(code,'manifest',18)
