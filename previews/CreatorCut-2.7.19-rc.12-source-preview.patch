+  with patch.object(setup,'doctor',side_effect=AssertionError('readiness on status')),patch.object(state,'snapshot',side_effect=AssertionError('full state on status')),patch.object(resources,'heavy',side_effect=AssertionError('heavy lock on status')):
+   result=editor.public('one')
+  self.assertEqual(result['request_id'],self.request)
+  self.assertIn(result['state'],{'queued','recovering'})
+
