+   try:
+    until=time.monotonic()+2
+    while not rpc.pending and time.monotonic()<until:time.sleep(.01)
+    rpc.close();self.assertTrue(done.wait(1));self.assertIsInstance(errors[0],util.Fail);self.assertFalse(rpc.pending)
+   finally:rpc.close();thread.join(2)
