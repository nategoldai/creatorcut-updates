+    """Legacy activity metadata alone cannot reserve a project indefinitely.
+
+    Current records identify their process birth. For an old record without an
+    identity, consult the real writer lock instead of trusting a possibly reused
+    PID. This never signals a process or removes a lock file.
+    """
+    if not activity.get('running') or not alive(activity.get('pid')):return False
+    if activity.get('birth'):return same_process(activity['pid'],activity['birth'])
