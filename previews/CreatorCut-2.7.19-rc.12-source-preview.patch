+
+def _review_integrity_errors(p,report,candidate):
+    errors=[]
+    for key,file in [('check_sha256','check.json'),('audio_check_sha256','audio-check.json')]:
+        if candidate.get(key) and (not (p/'render'/file).is_file() or digest(p/'render'/file)!=candidate[key]):errors.append('Registered '+file+' changed after rendering.')
