+class StartHandoff(unittest.TestCase):
+ def setUp(self):
+  self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup)
+  root=Path(self.tmp.name);self.p=root/'projects/one';self.p.mkdir(parents=True)
+  for key,value in {'ROOT':root,'PROJECTS':root/'projects','STUDIO_OUT':root/'out'}.items():
+   p=patch.object(util,key,value);p.start();self.addCleanup(p.stop)
+  util.write_json(self.p/'project.json',{'name':'one','media':[],'brief':{'prompt':'exact custom instructions'}})
+  self.request=requests.create('one')['id']
+ def test_blocked_supervisor_never_blocks_acceptance_or_duplicate_click(self):
+  entered=threading.Event();release=threading.Event();finished=threading.Event()
+  def blocked():
+   entered.set();release.wait(3);finished.set()
+  with patch.object(editor,'ensure_worker',side_effect=blocked) as ensure:
+   try:
+    start=time.monotonic();a=editor.enqueue('one',self.request)
+    self.assertLess(time.monotonic()-start,.5);self.assertTrue(entered.wait(1))
+    b=editor.enqueue('one',self.request)
+    self.assertEqual(a['job'],b['job']);self.assertEqual(ensure.call_count,1)
+    self.assertEqual(editor.read('one')['request_id'],self.request)
+   finally:
+    release.set();self.assertTrue(finished.wait(1))
+    deadline=time.monotonic()+1
+    while editor._wake_running and time.monotonic()<deadline:time.sleep(.001)
+ def test_thread_creation_failure_still_has_durable_job_and_watchdog_retry(self):
+  with patch.object(editor.threading.Thread,'start',side_effect=RuntimeError('injected thread exhaustion')):
+   result=editor.enqueue('one',self.request)
+  self.assertTrue(result['accepted']);self.assertFalse(editor._wake_running)
+  self.assertEqual(editor.read('one')['id'],result['job'])
+  stop=threading.Event()
+  with patch.object(editor,'ensure_worker',side_effect=lambda:stop.set()) as ensure:
+   editor.watchdog(stop);ensure.assert_called_once()
