+class WriterDisconnect(unittest.TestCase):
+ def test_queued_sends_fail_immediately_and_closed_pipe_cleanup_is_safe(self):
+  from concurrent.futures import Future
+  from unittest.mock import Mock
+  import queue
+  rpc=object.__new__(RPC);rpc.closed=threading.Event();rpc.closed.set();rpc.outgoing=queue.Queue()
+  rpc.process=Mock();rpc.process.stdin.close.side_effect=BrokenPipeError('child exited')
+  waiting=Future();rpc.outgoing.put(('saved request',waiting))
