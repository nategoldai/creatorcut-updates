+    check=util.read_json(p/'render/check.json',default={})
+    exceptions=report.get('exceptions',[])
+    for finding in check.get('review_findings',[]):
+        resolution=next((row for row in exceptions if isinstance(row,dict) and row.get('finding')==finding.get('id')),{})
