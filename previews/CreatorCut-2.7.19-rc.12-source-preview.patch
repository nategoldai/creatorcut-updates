+from editkit import util,activity_store
+class ProcessActivityTests(unittest.TestCase):
+ def test_windows_liveness_never_sends_a_signal(self):
+  api=Mock();api.OpenProcess.return_value=123
+  def code(handle,out):out._obj.value=259;return 1
+  api.GetExitCodeProcess.side_effect=code
+  with patch.object(util.sys,'platform','win32'),patch.object(ctypes,'WinDLL',return_value=api,create=True),patch.object(util.os,'kill') as kill:
+   self.assertTrue(util.process_alive(99))
+   api.GetExitCodeProcess.side_effect=lambda handle,out:(setattr(out._obj,'value',0) or 1)
+   self.assertFalse(util.process_alive(99));kill.assert_not_called()
+  self.assertEqual(api.CloseHandle.call_count,2)
+ def test_windows_creation_identity_does_not_require_ps(self):
+  api=Mock();api.OpenProcess.return_value=123
+  def times(handle,created,*unused):created._obj.dwHighDateTime=42;created._obj.dwLowDateTime=27;return 1
+  api.GetProcessTimes.side_effect=times
+  with patch.object(util.sys,'platform','win32'),patch.object(ctypes,'WinDLL',return_value=api,create=True),patch.object(util.subprocess,'check_output') as ps:
+   self.assertEqual(util.process_identity(99),'win:'+str((42<<32)|27));ps.assert_not_called()
+  api.CloseHandle.assert_called_once_with(123)
+ def test_invalid_pid_never_queries_any_process(self):
+  with patch.object(util.os,'kill') as kill:
+   for pid in (0,-1,None,True,'123'):
+    self.assertFalse(util.process_alive(pid));self.assertEqual(util.process_identity(pid),'')
+   kill.assert_not_called()
